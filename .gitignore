# Operating System & Environment Artifacts
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Ingestion Folder
# Ephemeral source files should never be committed
/ingest/*
!/ingest/.gitkeep
/ingest/failed/*
!/ingest/failed/.gitkeep

